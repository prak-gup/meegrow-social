# Copy to /opt/meegrow-social/.env on the server and fill in. NEVER commit the filled file.
# This file is read BOTH by docker compose (for ${VAR} interpolation) and passed into the
# api/worker containers (env_file). Host names are compose service names (postgres, redis).

# --- Postgres (container) ---
POSTGRES_PASSWORD=CHANGE_ME_strong_random
APP_DB_PASSWORD=CHANGE_ME_strong_random_app_role

# --- App DB connections ---
# Admin (migrations/provisioning/auth) connects as superuser mgs; app connects as NON-superuser
# mgs_app so RLS is enforced (see docs — superusers bypass RLS).
DATABASE_URL=postgres://mgs:CHANGE_ME_strong_random@postgres:5432/meegrow_social
APP_DATABASE_URL=postgres://mgs_app:CHANGE_ME_strong_random_app_role@postgres:5432/meegrow_social
REDIS_URL=redis://redis:6379

# --- App ---
API_PORT=8990
APP_URL=https://social.meegrowlabs.com
# 32+ char random — encrypts provider tokens at rest. Changing it invalidates stored tokens.
TOKEN_ENCRYPTION_KEY=CHANGE_ME_32_plus_random_chars

# --- Media (staging: local disk served via Caddy at /media). Switch to s3 for scale. ---
MEDIA_STORAGE_DRIVER=disk
MEDIA_DISK_DIR=/app/.data/media
MEDIA_PUBLIC_BASE_URL=https://social.meegrowlabs.com/media

# --- Provider credentials (added as providers land; keep blank until then) ---
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# (instagram uses the same Meta app)
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=   # GBP
# GOOGLE_CLIENT_SECRET=
# X_API_KEY=
# X_API_SECRET=
