# Copy to .env for local dev. docker-compose.dev.yml maps Postgres→5433, Redis→6380.
# Admin connection (migrations, provisioning, auth). May be superuser.
DATABASE_URL=postgres://mgs:mgs@localhost:5433/meegrow_social
# Application connection — the NON-superuser role RLS is enforced against. Created by db:migrate.
APP_DATABASE_URL=postgres://mgs_app:mgs_app@localhost:5433/meegrow_social
REDIS_URL=redis://localhost:6380
API_PORT=8990
APP_URL=http://localhost:8990
# Comma-free base64/hex secret used to encrypt provider tokens at rest.
TOKEN_ENCRYPTION_KEY=dev-only-change-me-32byteslong-00
# Media storage driver (issue #3): "disk" (default, dev/test — no AWS needed) or "s3" (prod).
MEDIA_STORAGE_DRIVER=disk
MEDIA_DISK_DIR=.data/media
MEDIA_PUBLIC_BASE_URL=http://localhost:8990/media
# Only read when MEDIA_STORAGE_DRIVER=s3. Credentials come from the standard AWS provider chain
# (IAM role on EC2), not env vars here.
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_PUBLIC_BASE_URL=
