# Add this block to the box's /etc/caddy/Caddyfile (alongside the existing postiz.meegrowlabs.com
# block) and `sudo systemctl reload caddy`. Caddy auto-provisions the TLS cert.
# API paths (JSON API, OAuth callback, MCP, disk-backed media) proxy to the api container;
# everything else serves the dashboard SPA, extracted from the image to /opt/meegrow-social/web-dist
# on each deploy (see DEPLOY.md / deploy.yml).
social.meegrowlabs.com {
	@api path /v1/* /connect/* /mcp /mcp/* /media/* /healthz
	handle @api {
		reverse_proxy 127.0.0.1:8990
	}
	handle {
		root * /opt/meegrow-social/web-dist
		# index.html is served for every SPA route and must be revalidated, or browsers keep the
		# previous build per-route after a deploy. Hashed files under /assets/ are left alone.
		@html not path /assets/*
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
